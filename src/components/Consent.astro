---
// Cookie consent for Google Analytics (GA4 stream "Mondesa"). Nothing from
// Google loads until the visitor accepts, and only on mondesa.com.br (never
// in dev or on workers.dev previews). The choice lives in localStorage
// (strictly necessary); `[data-consent-open]` (footer, privacy page) reopens
// the box, and declining after accepting turns GA off and clears its cookies.
// Accept and decline carry equal weight (GDPR, ANPD). Plain script, outside
// the React island, so it works before hydration. Text follows the site's
// language choice (`mondesa-language`), like LanguageContext.
const GA_ID = 'G-LE1YTT5KFC';
---

<section class="consent" role="dialog" aria-labelledby="consent-title" aria-describedby="consent-text" data-consent data-ga={GA_ID} hidden>
	<p id="consent-title" class="consent__title" data-k="title"></p>
	<p id="consent-text" class="consent__text"><span data-k="text"></span> <a href="/privacy" data-k="more"></a></p>
	<div class="consent__actions">
		<button type="button" class="consent__btn consent__btn--ink" data-consent-choice="granted" data-k="accept"></button>
		<button type="button" class="consent__btn" data-consent-choice="denied" data-k="decline"></button>
	</div>
</section>

<script>
	const KEY = 'mondesa-consent';
	type Choice = 'granted' | 'denied';
	type Lang = 'pt' | 'en';

	const T: Record<Lang, Record<string, string>> = {
		en: {
			title: 'Cookies',
			text: 'We’d like to use Google Analytics to see which pages people read, so we can make the site better. It sets cookies only if you accept. No ads, no selling data.',
			more: 'Privacy policy',
			accept: 'Accept',
			decline: 'Decline',
		},
		pt: {
			title: 'Cookies',
			text: 'Queremos usar o Google Analytics para ver quais páginas as pessoas leem e melhorar o site. Ele só grava cookies se você aceitar. Sem anúncios, sem venda de dados.',
			more: 'Política de privacidade',
			accept: 'Aceitar',
			decline: 'Recusar',
		},
	};

	const box = document.querySelector<HTMLElement>('[data-consent]');
	const id = box?.dataset.ga;
	const live = /(^|\.)mondesa\.com\.br$/.test(location.hostname);

	const lang = (): Lang => {
		try {
			const v = localStorage.getItem('mondesa-language');
			if (v === 'pt' || v === 'en') return v;
		} catch {}
		return navigator.language.split('-')[0] === 'pt' ? 'pt' : 'en';
	};
	const paint = () => {
		const t = T[lang()];
		box?.querySelectorAll<HTMLElement>('[data-k]').forEach((el) => (el.textContent = t[el.dataset.k!]));
	};

	const read = (): Choice | null => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'granted' || v === 'denied' ? v : null;
		} catch {
			return null;
		}
	};
	const save = (v: Choice) => {
		try {
			localStorage.setItem(KEY, v);
		} catch {}
	};

	const w = window as unknown as { dataLayer: unknown[]; gtag: (...a: unknown[]) => void } & Record<string, unknown>;
	let loaded = false;

	const startGa = () => {
		if (!id) return;
		w[`ga-disable-${id}`] = false;
		if (loaded) {
			w.gtag('consent', 'update', { analytics_storage: 'granted' });
			return;
		}
		loaded = true;
		w.dataLayer = w.dataLayer || [];
		// gtag.js only reads `arguments` objects, not arrays.
		w.gtag = function () {
			// eslint-disable-next-line prefer-rest-params
			w.dataLayer.push(arguments);
		};
		// Consent Mode v2: analytics only, never ads or personalisation.
		w.gtag('consent', 'default', {
			analytics_storage: 'granted',
			ad_storage: 'denied',
			ad_user_data: 'denied',
			ad_personalization: 'denied',
		});
		w.gtag('js', new Date());
		w.gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
		const s = document.createElement('script');
		s.async = true;
		s.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
		document.head.appendChild(s);
	};

	const stopGa = () => {
		if (!id) return;
		w[`ga-disable-${id}`] = true;
		if (loaded) w.gtag('consent', 'update', { analytics_storage: 'denied' });
		const parts = location.hostname.split('.');
		const domains = parts.map((_, i) => parts.slice(i).join('.')).filter((d) => d.includes('.'));
		for (const name of document.cookie.split(';').map((c) => c.split('=')[0].trim())) {
			if (!name.startsWith('_ga')) continue;
			for (const d of ['', ...domains.map((d) => `;domain=.${d}`)]) {
				document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/${d}`;
			}
		}
	};

	const show = () => {
		if (!box) return;
		paint();
		box.hidden = false;
		requestAnimationFrame(() => box.classList.add('is-in'));
	};
	const hide = () => {
		if (!box) return;
		box.classList.remove('is-in');
		setTimeout(() => (box.hidden = true), 250);
	};

	if (box && live) {
		const choice = read();
		if (choice === 'granted') startGa();
		else if (!choice) show();

		box.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-consent-choice]');
			if (!btn) return;
			const v = btn.dataset.consentChoice as Choice;
			save(v);
			v === 'granted' ? startGa() : stopGa();
			hide();
		});

		document.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('[data-consent-open]')) {
				e.preventDefault();
				show();
				return;
			}
			// The language selector writes its choice on click; follow it.
			if (!box.hidden) setTimeout(paint, 0);
		});
	} else {
		// Off here (dev, previews): hide the settings links once React renders them.
		const style = document.createElement('style');
		style.textContent = '[data-consent-open]{display:none!important}';
		document.head.appendChild(style);
	}
</script>

<style>
	.consent {
		position: fixed;
		left: 16px;
		bottom: 16px;
		z-index: 1400;
		width: min(24rem, calc(100vw - 32px));
		padding: 20px 20px 18px;
		border: 1px solid #e1e6e3;
		border-radius: 12px;
		background: #ffffff;
		color: #444b54;
		font-family: 'IBM Plex Sans', system-ui, sans-serif;
		box-shadow: 0 12px 32px rgba(68, 75, 84, 0.16);
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.consent[hidden] {
		display: none;
	}

	.consent.is-in {
		opacity: 1;
		transform: none;
	}

	.consent__title {
		margin: 0;
		font-family: 'Poppins', system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.consent__text {
		margin: 6px 0 0;
		font-size: 0.85rem;
		line-height: 1.55;
		color: #666d76;
	}

	.consent__text a {
		color: #456a78;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.consent__actions {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 8px;
		margin-top: 16px;
	}

	.consent__btn {
		padding: 10px 14px;
		border: 1px solid #d4dcd8;
		border-radius: 8px;
		background: transparent;
		font: inherit;
		font-size: 0.85rem;
		font-weight: 600;
		color: #444b54;
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			border-color 0.2s ease;
	}

	.consent__btn:hover {
		border-color: #444b54;
	}

	.consent__btn--ink {
		border-color: #444b54;
		background: #444b54;
		color: #ffffff;
	}

	.consent__btn--ink:hover {
		border-color: #456a78;
		background: #456a78;
	}

	@media (prefers-reduced-motion: reduce) {
		.consent {
			transition: none;
		}
	}
</style>
